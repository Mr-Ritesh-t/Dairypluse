# ==============================================================
# DairyPulse Backend Environment Variables
# ==============================================================

# Database Connection (Supabase PostgreSQL or Local SQLite)
# For Supabase (Session Pooler or Direct):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///./dairypulse.db

# Security & Tokens
SECRET_KEY=generate_a_secure_random_key_here_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated list of your Vercel frontend domains)
# Example: https://dairypulse.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=https://*.vercel.app,http://localhost:3000

# Application Settings
PROJECT_NAME="DairyPulse API"
VERSION="1.0.0"
TIMEZONE="Asia/Kolkata"
